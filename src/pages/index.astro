---
import '../styles/tokens.css';
import { AppShell } from '../components/AppShell';
import coreRules from '../data/core_rules.json';
import allComponents from '../data/all_components.json';
import artManifest from '../data/image_generation_manifest.json';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AWAY TEAM — Semi-Cooperative Tactical Tabletop Engine</title>
    <meta
      name="description"
      content="Official digital hub for Away Team: 6.0 tabletop rulebook, 200-component card database, browser Virtual Tabletop (VTT), Monte Carlo simulator, and design dossiers."
    />
  </head>
  <body>
    <AppShell
      client:load
      initialMode="home"
      coreRules={coreRules}
      components={allComponents}
      artManifest={artManifest}
    />
  </body>
</html>
